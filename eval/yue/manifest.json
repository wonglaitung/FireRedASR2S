    "source_index": 12,
    "duration_s": 2.98,
    "sample_rate": 16000,
    "audio": "audio/yue_009.wav",
    "transcript": "帶有威嚇嘅公開聲明、預言"
  },
  {
    "id": "010",
    "source": "AlienKevin/wordshk_cantonese_speech",
    "source_index": 14,
    "duration_s": 2.98,
    "sample_rate": 16000,
    "audio": "audio/yue_010.wav",
    "transcript": "而家都係揾兩份兼職做住先咋。"
  },
  {
