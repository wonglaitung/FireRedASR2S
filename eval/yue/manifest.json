    "duration_s": 2.5,
    "sample_rate": 16000,
    "audio": "audio/yue_007.wav",
    "transcript": "廟宇兩進之間建有香亭。"
  },
  {
    "id": "008",
    "source": "AlienKevin/wordshk_cantonese_speech",
    "source_index": 11,
    "duration_s": 2.16,
    "sample_rate": 16000,
    "audio": "audio/yue_008.wav",
    "transcript": "我反為鍾意睇卡通片。"
  },
  {
