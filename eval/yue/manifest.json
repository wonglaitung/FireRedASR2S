    "source": "AlienKevin/wordshk_cantonese_speech",
    "source_index": 6,
    "duration_s": 3.74,
    "sample_rate": 16000,
    "audio": "audio/yue_004.wav",
    "transcript": "定出一個雙方覺得過高，唔合理嘅要求"
  },
  {
