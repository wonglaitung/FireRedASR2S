    "source": "AlienKevin/wordshk_cantonese_speech",
    "source_index": 7,
    "duration_s": 2.3,
    "sample_rate": 16000,
    "audio": "audio/yue_005.wav",
    "transcript": "拜託你將呢本書攞俾佢吖。"
  },
  {
