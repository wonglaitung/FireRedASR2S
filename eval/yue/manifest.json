    "source": "AlienKevin/wordshk_cantonese_speech",
    "source_index": 8,
    "duration_s": 3.74,
    "sample_rate": 16000,
    "audio": "audio/yue_006.wav",
    "transcript": "一種由豬蹄製成嘅食物（量詞：隻）"
